# Private workspace root (the only value enabled by default)
CAREER_AGENT_WORKBENCH_WORKSPACE=../career-agent-workbench-ops

# Optional workspace-member overrides
# CAREER_AGENT_WORKBENCH_PROFILE_DIR=profile
# CAREER_AGENT_WORKBENCH_MASTER_RESUME=profile/MASTER-RESUME.yml
# CAREER_AGENT_WORKBENCH_MASTER_RESUME_TEXT=profile/MP-MASTER-RESUME.txt
# CAREER_AGENT_WORKBENCH_OUTPUT_DIR=output
# CAREER_AGENT_WORKBENCH_DATABASE=output/tracking/applications.sqlite3
# CAREER_AGENT_WORKBENCH_BLACKLIST=.blacklist
# CAREER_AGENT_WORKBENCH_TMP_DIR=tmp

# Optional runtime settings
# CAREER_AGENT_WORKBENCH_USER_AGENT=public-browser-user-agent
# CAREER_AGENT_WORKBENCH_TIMEOUT_SECONDS=12
# CAREER_AGENT_WORKBENCH_MAX_RESULTS=25
# CAREER_AGENT_WORKBENCH_OLLAMA_BASE_URL=http://127.0.0.1:11434
# CAREER_AGENT_WORKBENCH_OLLAMA_MODEL=qwen3:4b
# CAREER_AGENT_WORKBENCH_OLLAMA_TIMEOUT_SECONDS=180
# CAREER_AGENT_WORKBENCH_LLM_API_BASE_URL=https://openrouter.ai/api/v1
# CAREER_AGENT_WORKBENCH_LLM_API_MODEL=deepseek/deepseek-chat
# CAREER_AGENT_WORKBENCH_LLM_PLANNER_API_MODEL=deepseek/deepseek-v4-flash
# CAREER_AGENT_WORKBENCH_LLM_API_KEY=
# CAREER_AGENT_WORKBENCH_LLM_API_TIMEOUT_SECONDS=360
# CAREER_AGENT_WORKBENCH_LLM_PROVIDER=api
