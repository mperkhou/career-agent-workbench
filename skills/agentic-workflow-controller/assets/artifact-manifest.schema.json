{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Agentic workflow artifact manifest",
  "type": "object",
  "required": [
    "schema_version",
    "manifest_id",
    "workflow_id",
    "step_id",
    "run_id",
    "created_at",
    "storage_root",
    "artifacts"
  ],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "manifest_id": { "type": "string", "minLength": 1 },
    "workflow_id": { "type": "string", "minLength": 1 },
    "step_id": { "type": "string", "minLength": 1 },
    "run_id": { "type": "string", "minLength": 1 },
    "created_at": { "type": "string", "minLength": 1 },
    "storage_root": {
      "type": "string",
      "enum": ["repo", "external"]
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["artifact_id", "path", "kind", "summary", "sha256"],
        "properties": {
          "artifact_id": { "type": "string", "minLength": 1 },
          "path": { "type": "string", "minLength": 1 },
          "kind": { "type": "string", "minLength": 1 },
          "summary": { "type": "string" },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "sensitive": { "type": "boolean" },
          "sanitized": { "type": "boolean" }
        },
        "additionalProperties": false
      }
    },
    "external_references": {
      "type": "array",
      "items": { "type": "string" }
    }
  },
  "additionalProperties": false
}
